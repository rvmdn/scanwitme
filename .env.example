# ScanWitMe Configuration Example
# Copy this file to .env and configure your local settings.
# NEVER commit your real .env file or real API keys to version control.

# Google Cloud Translation Basic (v2) API Key
# Required when using CloudTranslationV2Provider
# Leave empty if using Google Translate Web Launcher only
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key_here

# Default Source Language (ko = Korean, zh-CN = Simplified Chinese, zh-TW = Traditional Chinese, auto = Auto-detect)
DEFAULT_SOURCE_LANGUAGE=ko

# Default Target Language (id = Indonesian)
DEFAULT_TARGET_LANGUAGE=id

# Default Translation Provider: cloud_v2 or web_launcher
DEFAULT_TRANSLATION_PROVIDER=cloud_v2

# Global Hotkey (e.g. <ctrl>+<shift>+s)
SCANWITME_HOTKEY=<ctrl>+<shift>+s

# Translation Cache DB file path (relative to user data directory or absolute)
SCANWITME_CACHE_DB=scanwitme_cache.db

# Log Level: DEBUG, INFO, WARNING, ERROR
SCANWITME_LOG_LEVEL=INFO
